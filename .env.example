# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# La URL y la clave anónima son PÚBLICAS por diseño: viajan en el bundle del
# navegador. Lo que protege los datos es Row-Level Security, no ocultar esta
# clave. Se pueden versionar sin riesgo.
VITE_SUPABASE_URL="https://ewtuavdebwzrjojifqyr.supabase.co"
VITE_SUPABASE_ANON_KEY="PEGUE_AQUI_LA_ANON_KEY"

# NUNCA ponga aquí la service_role key. Se salta RLS por completo y en el
# cliente equivale a publicar la base de datos entera. Solo en el servidor.

# Referencia del proyecto, para `npm run db:types` y `supabase db push`.
SUPABASE_PROJECT_REF="ewtuavdebwzrjojifqyr"
